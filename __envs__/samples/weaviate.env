TZ=Asia/Tokyo
QUERY_DEFAULTS_LIMIT=20
AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED=false
PERSISTENCE_DATA_PATH=/app/weaviate/data
BACKUP_FILESYSTEM_PATH=/app/weaviate/data/backups
CLUSTER_HOSTNAME=node1
AUTHENTICATION_APIKEY_ENABLED=true
AUTHENTICATION_APIKEY_ALLOWED_KEYS=<WEAVIATE_USER_KEY_1>,<WEAVIATE_USER_KEY_2>
AUTHENTICATION_APIKEY_USERS=<WEAVIATE_USER_1>,<WEAVIATE_USER_2>
AUTHORIZATION_ENABLE_RBAC=true
AUTHORIZATION_RBAC_ROOT_USERS=<WEAVIATE_USER_n>

# Weaviateにアクセスするための複数ユーザの設定が可能
# 下記は例
# AUTHENTICATION_APIKEY_ALLOWED_KEYS=key-a,key-b
# AUTHENTICATION_APIKEY_USERS=user-a,user-b
# AUTHORIZATION_ENABLE_RBAC=true
# AUTHORIZATION_RBAC_ROOT_USERS=user-a